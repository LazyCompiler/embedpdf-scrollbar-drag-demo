{
  "name": "embedpdf-scrollbar-drag-demo-fixed",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "rm -rf src && cp -R ../source/src src && cp ../source/index.html ../source/tsconfig.json .",
    "dev": "pnpm sync && vite",
    "build": "pnpm sync && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@embedpdf/engine": "3.3.0",
    "@embedpdf/react": "file:./packages/embedpdf-react-3.3.0.tgz",
    "@embedpdf/web": "file:./packages/embedpdf-web-3.3.0.tgz",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "pnpm": {
    "overrides": {
      "@embedpdf/web": "$@embedpdf/web"
    }
  }
}
